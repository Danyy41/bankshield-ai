# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
build/
dist/

# Data & model artifacts (regenerate via `python scripts/run_all.py`).
# Metrics JSON is versioned (plain text) so results are visible on GitHub
# without running the pipeline. Figures are PNG binaries and are gitignored
# here for tooling reasons in this dev environment -- run the pipeline to
# generate them locally, or see reports/model_comparison.md for the numbers.
data/raw/*.csv
data/processed/*.csv
models/*.joblib
models/*.pkl
reports/figures/*.png

!data/raw/.gitkeep
!data/processed/.gitkeep
!models/.gitkeep
!reports/figures/.gitkeep

# Local durable state (SQLite database: users, approvals, cases, audit log)
var/

# Editors / OS
.vscode/
.idea/
.DS_Store

# Jupyter
.ipynb_checkpoints/

# Secrets and local credentials -- never commit these
.env
.env.*
*.pem
*.key
.aws/
credentials
*.db
*.sqlite

# Local tool caches and CI outputs
.pytest_cache/
.ruff_cache/
pytest-results.xml
pip-freeze.txt
container.log
